generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  男
  女
}

enum AllergySeverity {
  轻微
  中等
  严重
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  sessions          Session[]
  aiCallLogs        AiCallLog[]
  medicalRecordAttachments MedicalRecordAttachment[]
  members           Member[]
  medicalRecords    MedicalRecord[]
  medicines         Medicine[]
  allergyRecords    AllergyRecord[]
  visitPreparations VisitPreparation[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks   KnowledgeChunk[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}


model Member {
  id               String            @id @default(cuid())
  userId           String
  name             String
  relationship     String
  birthYear        Int?
  gender           Gender            @default(男)
  allergySummary   String            @default("暂无明确过敏摘要。")
  note             String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  medicalRecords   MedicalRecord[]
  medicines        Medicine[]
  allergyRecords   AllergyRecord[]
  visitPreparations VisitPreparation[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
}

model MedicalRecord {
  id                 String   @id @default(cuid())
  userId             String
  memberId           String
  visitedAt          DateTime
  hospitalName       String
  department         String
  symptoms           String
  diagnosis          String
  clinicalSummary    String   @default("")
  examinationResults String   @default("")
  followUpAt         String   @default("")
  doctorAdvice       String
  prescriptionNote   String   @default("")
  note               String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  member             Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments        MedicalRecordAttachment[]

  @@index([userId, memberId, visitedAt(sort: Desc)])
}

model MedicalRecordAttachment {
  id        String   @id @default(cuid())
  userId    String
  recordId  String
  fileKey   String
  fileName  String
  mimeType  String
  kind      String   @default("检查报告")
  note      String   @default("")
  aiDocumentType String @default("")
  aiSummary String @default("")
  aiKeyFindings String[]
  aiSuggestedFollowUp String @default("")
  aiOriginalText String @default("")
  aiWarnings String[]
  aiExtractedAt DateTime?
  createdAt DateTime @default(now())
  record    MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordId, createdAt(sort: Desc)])
}

model Medicine {
  id              String   @id @default(cuid())
  userId          String
  memberId        String
  name            String
  category        String
  dosage          String
  instructions    String
  purpose         String
  specification   String
  quantity        String
  expiresAt       DateTime
  storageLocation String
  usageNote       String
  safetyNote      String
  imageBytes      Bytes?
  imageMimeType   String?
  imageName       String?
  imageKey        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memberId, expiresAt(sort: Asc)])
}

model AllergyRecord {
  id           String          @id @default(cuid())
  userId       String
  memberId     String
  allergen     String
  reaction     String
  severity     AllergySeverity
  discoveredAt DateTime
  note         String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memberId, discoveredAt(sort: Desc)])
}

model VisitPreparation {
  id        String   @id @default(cuid())
  userId    String
  memberId  String
  concern   String
  summary   String
  questions String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memberId, createdAt(sort: Desc)])
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  userId    String
  title     String
  category  String
  source    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    KnowledgeChunk[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, title])
  @@index([userId, category])
  @@index([userId, source])
  @@index([userId, createdAt(sort: Desc)])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  chunkIndex Int
  content    String   @db.Text
  keywords   String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentId, chunkIndex])
  @@index([userId, createdAt(sort: Desc)])
}

model AiCallLog {
  id           String   @id @default(cuid())
  userId       String
  routeKey     String
  provider     String
  model        String
  status       String
  inputBytes   Int      @default(0)
  outputBytes  Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, routeKey, createdAt(sort: Desc)])
}
