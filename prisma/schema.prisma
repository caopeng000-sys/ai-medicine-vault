generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  男
  女
}

enum AllergySeverity {
  轻微
  中等
  严重
}

model User {
  id                String             @id @default(cuid())
  email             String?            @unique
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  members           Member[]
  medicalRecords           MedicalRecord[]
  medicalRecordAttachments MedicalRecordAttachment[]
  medicines                Medicine[]
  allergyRecords    AllergyRecord[]
  visitPreparations VisitPreparation[]
  aiConversations   AiConversation[]
}

model Member {
  id               String            @id @default(cuid())
  userId           String
  name             String
  relationship     String
  birthYear        Int?
  gender           Gender            @default(男)
  allergySummary   String            @default("暂无明确过敏摘要。")
  note             String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  medicalRecords           MedicalRecord[]
  medicalRecordAttachments MedicalRecordAttachment[]
  medicines                Medicine[]
  allergyRecords   AllergyRecord[]
  visitPreparations VisitPreparation[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
}

model MedicalRecord {
  id               String   @id @default(cuid())
  userId           String
  memberId         String
  visitedAt        DateTime
  hospitalName     String
  department       String
  symptoms         String
  diagnosis        String
  doctorAdvice     String
  prescriptionNote String   @default("")
  note             String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  member      Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments MedicalRecordAttachment[]

  @@index([userId, memberId, visitedAt(sort: Desc)])
}

model MedicalRecordAttachment {
  id              String         @id @default(cuid())
  userId          String
  memberId        String
  medicalRecordId String?
  fileName        String
  mimeType        String
  fileBytes       Bytes?
  extractedText   String
  createdAt       DateTime       @default(now())
  member          Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memberId, createdAt(sort: Desc)])
  @@index([userId, medicalRecordId])
}

model Medicine {
  id              String   @id @default(cuid())
  userId          String
  memberId        String
  name            String
  category        String
  dosage          String
  instructions    String
  purpose         String
  specification   String
  quantity        String
  expiresAt       DateTime
  storageLocation String
  usageNote       String
  safetyNote      String
  imageBytes      Bytes?
  imageMimeType   String?
  imageName       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memberId, expiresAt(sort: Asc)])
}

model AllergyRecord {
  id           String          @id @default(cuid())
  userId       String
  memberId     String
  allergen     String
  reaction     String
  severity     AllergySeverity
  discoveredAt DateTime
  note         String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memberId, discoveredAt(sort: Desc)])
}

model VisitPreparation {
  id        String   @id @default(cuid())
  userId    String
  memberId  String
  concern   String
  summary   String
  questions String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memberId, createdAt(sort: Desc)])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String
  intent    String
  message   String?
  sources   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
